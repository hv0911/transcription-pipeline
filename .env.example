# Copy to .env to override defaults. Every value here is optional.

# ---------- Speech-to-text engine ----------
# faster_whisper | fake  (fake = no model download, for demos and tests)
TRANSCRIBER_ENGINE=faster_whisper
# tiny | base | small | medium | large-v3  (CPU default: base)
WHISPER_MODEL=base
# auto | cpu | cuda  (auto = GPU if one is usable, otherwise CPU)
WHISPER_DEVICE=auto
# auto = float16 on GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=auto
# Higher = slightly more accurate, slower
BEAM_SIZE=5

# ---------- Input limits ----------
# Uploads larger than this get HTTP 413
MAX_UPLOAD_MB=500
# 3 hours; longer audio fails with error code too_long
MAX_DURATION_SEC=10800

# ---------- Long audio ----------
# Files longer than this are split into chunks
CHUNK_THRESHOLD_SEC=600
# Preferred chunk length (the cut is placed in the nearest silence)
CHUNK_TARGET_SEC=300
# Hard cut if no silence is found
CHUNK_MAX_SEC=450

# ---------- Output quality ----------
# Segments below this confidence are flagged low_confidence
CONFIDENCE_THRESHOLD=0.5

# ---------- Jobs ----------
# Above this many waiting jobs, uploads get HTTP 503 (backpressure)
MAX_QUEUE_DEPTH=100
# Automatic retries for transient failures
MAX_RETRIES=3
# A single attempt is stopped after this long
JOB_TIMEOUT_SEC=3600
# A job in "processing" with no progress for this long is treated as orphaned and recovered
STALE_JOB_SEC=600

LOG_LEVEL=INFO

# ---------- Infrastructure (docker-compose already sets these) ----------
# DATABASE_URL=postgresql+psycopg://transcribe:transcribe@postgres:5432/transcribe
# REDIS_URL=redis://redis:6379/0
# DATA_DIR=/data

# ---------- GPU profile only (docker-compose.gpu.yml) ----------
GPU_WHISPER_MODEL=small
GPU_COMPUTE_TYPE=int8_float16
